# انسخ هذا الملف إلى .env وعدّل القيم

PORT=3000
# رابط الموقع النهائي (يُستخدم في روابط التتبع داخل الإشعارات)
SITE_URL=http://localhost:3000
# كلمة مرور لوحة التحكم (8 أحرف على الأقل، اجعلها قوية)
ADMIN_PASSWORD=change-me-please

# مجلد حفظ البيانات
DATA_DIR=./data

# (اختياري) إشعارات واتساب التلقائية عبر WhatsApp Cloud API من Meta
# بدونها تظهر في لوحة التحكم رسالة جاهزة للإرسال اليدوي بضغطة زر
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# اسم قالب معتمد من Meta بثلاثة متغيرات: {{1}} الاسم، {{2}} الحالة، {{3}} رقم الطلب
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
